# ========================================================
# BOTIQUÍN AL DÍA - Variables de Entorno de Ejemplo
# ========================================================
# Copie este archivo como .env y complete sus valores si aplica.
# En Android con Secrets Gradle Plugin, las claves aquí definidas
# se inyectan de forma segura en BuildConfig sin subirse al repositorio.

# Clave de Gemini API (Opcional para futuras versiones inteligentes M5)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Entorno de ejecución (development / production)
APP_ENV=development
